LLM_PROVIDER=llama
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_API_BASE=https://api.llama-api.com
LLAMA_AGENT_MODEL=llama3.3-70b
LLAMA_EXTRACT_MODEL=llama3.1-8b

GROQ_API_KEY=your_groq_api_key_here
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b

# Optional. Defaults to a local SQLite file so the demo runs without Docker.
# DATABASE_URL=postgresql+psycopg2://qms:qms@localhost:5432/qms
